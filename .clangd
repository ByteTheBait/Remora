# clangd configuration for Remora.
#
# The driver `src/main_llama.cpp` links against the system libllama (b10180)
# via pkg-config, so it must use the system headers from Homebrew, NOT the
# vendored ones in third_party/llama.cpp/. The vendored copy differs from
# the system ABI in subtle ways (GGML_ROPE_TYPE_NEOX flags, sampler API
# names, etc.) — pointing clangd at the vendored headers produces spurious
# "undeclared identifier" errors when indexinig llama.h.
#
# We match the build command exactly: -isystem for the Homebrew include
# paths so they outrank any framework defaults, and quiet the unused-header
# diagnostics clangd otherwise emits for every stdlib header we include.

CompileFlags:
  Add:
    - -std=gnu++20
    - -DREMORA_HAVE_GGML=1
    - -I/Users/henry/Developer/Remora/src
    - -I/opt/homebrew/Cellar/ggml/0.20.1/include
    - -isystem/opt/homebrew/Cellar/llama.cpp/10450/include
  Remove:
    - -isystem/opt/homebrew/include

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: None
  Suppress:
    - -Wunused-include
